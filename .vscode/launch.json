{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EngineStarter (GDB, debug-ninja)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/debug-ninja/bin/EngineStarter.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/out/build/debug-ninja/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build (debug-ninja)"
        },
        {
            "name": "EngineStarter (MSVC, vs2022 Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/vs2022-x64/bin/Debug/EngineStarter.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/out/build/vs2022-x64/bin/Debug",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "cmake: build (vs2022-x64 Debug)"
        }
    ]
}
